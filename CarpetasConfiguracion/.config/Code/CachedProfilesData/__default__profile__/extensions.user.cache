 from Microsoft","publisher":"ms-dotnettools","version":"3.40.210","aiKey":"0c6ae279ed8443289764825290e4f9e2-1a736e7c-1324-4338-be46-fc2a58ae4d14-7255","preview":false,"license":"SEE LICENSE IN LICENSE.md","qna":"https://github.com/microsoft/vscode-dotnettools/issues","icon":"c-sharp-icon.png","bugs":{"url":"https://github.com/microsoft/vscode-dotnettools/issues"},"engines":{"vscode":"^1.101.0"},"categories":["Programming Languages","Debuggers","Testing","Linters"],"repository":{"type":"git","url":" https://devdiv.visualstudio.com/DevDiv/_git/vs-green"},"keywords":["c#","csharp","devkit","dotnet","asp.net"],"activationEvents":["onDebugDynamicConfigurations:dotnet","onCommand:csdevkit.searchProjectFromCommandPalette","onCommand:csdevkit.searchOpenFromCommandPalette","onCommand:csdevkit.searchFromCommandPalette","onWebviewPanel:csdevkit.installDotnetSdk","onWebviewPanel:csdevkit.checkDotnetRequirements","workspaceContains:**/*.csproj","onLanguage:csharp"],"main":"./dist/extension.js","capabilities":{"untrustedWorkspaces":{"supported":"limited"},"virtualWorkspaces":{"supported":false}},"contributes":{"chatSkills":[{"path":"./src/copilot/skills/dotnet-aspnetcore/dotnet-webapi/SKILL.md","when":"csdevkit.dotnetSkillsEnabled"},{"path":"./src/copilot/skills/dotnet-diag/analyzing-dotnet-performance/SKILL.md","when":"csdevkit.dotnetSkillsEnabled"},{"path":"./src/copilot/skills/dotnet-test/run-tests/SKILL.md","when":"csdevkit.dotnetSkillsEnabled"}],"chatPlugins":[{"path":"./src/copilot/plugin","when":"csdevkit.dotnetSkillsEnabled"}],"mcpServerDefinitionProviders":[{"id":"csdevkit.nuget-mcp","label":"NuGet MCP Server"}],"keybindings":[{"command":"csdevkit.debug.hotReload","key":"Ctrl+Shift+Enter","when":"hotReloadEnabled"}],"configuration":[{"title":"C# Dev Kit","properties":{"dotnet.autoDetect":{"scope":"application","type":"string","enum":["off","on"],"default":"on","description":"Controls auto detection of dotnet tasks."},"dotnet.preferVisualStudioCodeFileSystemWatcher":{"scope":"window","type":"boolean","default":false,"description":"Controls whether the extension uses the default Visual Studio Code File System Watcher. This is recommended if you have a files.watcherExclude setting."},"dotnet.enablePublishIssuesToProblems":{"scope":"window","type":"boolean","default":true,"description":"[Preview] Publish project system initialization issues to the problems window.","tags":["preview","experimental"]},"dotnet.projectsystem.useNewMemoryOptimization":{"scope":"window","type":"boolean","default":false,"description":"Turn on memory allocation optimization in the project system hosting process (work in progress)","tags":["preview","experimental"]},"dotnet.projectsystem.enableLanguageServiceCache":{"scope":"window","type":"boolean","default":true,"description":"Enable writing and reading language service cache files (.lscache) alongside projects to improve IntelliSense performance (work in progress)","tags":["preview","experimental"]},"dotnet.projectsystem.cacheInProjectFolder":{"scope":"window","type":"boolean","default":false,"description":"Controls where language service cache files (.lscache) are stored. True to store alongside projects. False to store in a temporary directory (work in progress)","tags":["preview","experimental"]},"dotnet.testWindow.enableNextTest":{"scope":"window","type":"boolean","default":true,"description":"Enable the lightweight test experience for C# tests. (experimental)","tags":["experimental"]},"dotnet.testWindow.disableAutoDiscovery":{"scope":"window","type":"boolean","default":false,"description":"Disable automatic test discovery when test binaries change on disk. This can avoid file locking issues when building large solutions."},"dotnet.testWindow.discoverTestsFromSource":{"scope":"window","type":"boolean","default":false,"description":"Enable discovering tests directly from C# source files. (experimental)","tags":["experimental"]},"dotnet.testWindow.disableBuildOnRefresh":{"scope":"window","type":"boolean","default":false,"description":"Disable automatic build when triggering a test discovery refresh. If this option is set, you must manually build your tests before refresh to make sure they are up to date."},"dotnet.testWindow.disableBuildOnRun":{"scope":"window","type":"boolean","default":false,"description":"Disable automatic build before running tests. If this option is set, you must manually build your tests before running to make sure they are up to date."},"dotnet.testWindow.skipTargetFrameworkCompatibilityCheck":{"scope":"window","type":"boolean","default":false,"description":"Disable checks for projects with compatible target frameworks. This may cause unstable or broken test behavior. Use at your own risk."},"dotnet.testWindow.enableTestExplorerDiff":{"scope":"window","type":"boolean","default":false,"description":"Enables the Test Explorer to show the diff of the test results."},"dotnet.testWindow.discoveryTimeoutInSec":{"scope":"window","type":"number","default":900,"description":"Override the default timeout (in seconds) for test discovery operations."},"dotnet.workingWithTestSignedSdk":{"scope":"machine","type":"boolean","default":false,"description":"Working with ad-hoc signed SDK on a Mac computer. This option forces the C# Dev Kit extension to work in a slower compatible mode, and should only be turned on environment when it is essential."},"dotnet.useLegacyDotnetResolution":{"scope":"window","type":"boolean","default":false,"description":"Use the legacy dotnet resolution. This is a temporary option to workaround potential issues with the new logic."},"dotnet.suppressSdkInstallView":{"scope":"window","type":"boolean","default":true,"description":"Suppress the automatic display of the C# Workspace Requirements view when required SDKs are not installed."},"csharp.experimental.debug.hotReload":{"scope":"machine","type":"boolean","default":false,"description":"[Experimental] Enables C# Hot Reload while debugging."},"dotnet.debug.suppressInvalidDebugTypeWarning":{"type":"boolean","default":false,"description":"Suppresses the warning dialog when attempting to debug a project with an unsupported DebugType (e.g. full or pdbonly)."},"csharp.debug.hotReloadOnSave":{"scope":"machine","type":"boolean","default":true,"description":"When true, saving a file will automatically apply changes when Hot Reload is available."},"csharp.debug.hotReloadVerbosity":{"scope":"machine","type":"string","enum":["minimal","detailed","diagnostic"],"enumDescriptions":["Show only minimal information.","Show detailed information about how changes are found and applied to the target process.","Show diagnostic information on each step of a hot reload operation. Useful when diagnosing unexpected behaviors."],"default":"minimal","description":"The verbosity of logging in the Output Panel for '.NET Hot Reload'. The order of levels from least verbose to most verbose is: 'minimal' < 'detailed' < 'diagnostic' (default: 'minimal')"},"csharp.preview.improvedLaunchExperience":{"scope":"window","type":"boolean","default":true,"description":"[Deprecated] This setting is always enabled and will be removed in a future release.","deprecationMessage":"This setting is always enabled and will be removed in a future release."},"nuget.includePrereleasePackageVersions":{"scope":"machine","type":"boolean","default":false,"description":"Include prerelease package versions for all NuGet package operations."},"csharp.debug.debugConsoleVerbosity":{"scope":"machine","type":"string","enum":["minimal","verbose"],"enumDescriptions":["Show minimal details in the debug console. Additional information is available in the 'C# Debugger' output window channel.","Show all information in the debug console."],"default":"minimal","markdownDescription":"Sets the log level for messages sent by the debugger for the Debug Console. [Learn more...](https://aka.ms/vscode/dotnet/debugConsoleVerbosity)"},"dotnet.copilot.enableDotnetSkills":{"scope":"window","type":"boolean","default":true,"description":"[Experimental] Enable in-box .NET Copilot skills that assist with ASP.NET Core Web API development, performance analysis, and running tests.","tags":["experimental"]},"dotnet.automaticallySyncWithActiveItem":{"scope":"window","type":"boolean","default":false,"description":"Enables/disables the feature for the extension to automatically track the currently active item in the editor and highlight it within the file explorer."}}}],"commands":[{"command":"csdevkit.revealInProjectDetails","title":"Reveal in C# Project Details","category":".NET"},{"command":"csdevkit.openSolution","title":"Switch Solution","category":".NET"},{"command":"csdevkit.addNewProject","title":"New Project...","category":".NET","icon":"$(add)"},{"command":"csdevkit.addNewProjectFromNewFileMenu","title":".NET: New Project...","icon":"$(add)"},{"command":"csdevkit.addNewProjectToFolder","title":"New .NET Project...","icon":"$(add)"},{"command":"csdevkit.addNewFile","title":"New File...","category":".NET","icon":"$(new-file)"},{"command":"csdevkit.addNewFileFromNewFileMenu","title":".NET: New File...","icon":"$(new-file)"},{"command":"csdevkit.addNewFileToFolder","title":"New .NET File...","icon":"$(new-file)"},{"command":"csdevkit.addProjectReference","title":"Add Project Reference","category":".NET"},{"command":"csdevkit.removeProjectReference","title":"Remove Project Reference","category":".NET"},{"command":"csdevkit.showEntitlementsStatus","title":"Show entitlement status"},{"command":"csdevkit.addExistingProject","title":"Add Existing Project...","category":".NET"},{"command":"csdevkit.addProjectToSolutionFromExplorer","title":"Add to Open Solution","category":".NET"},{"command":"csdevkit.removeProject","title":"Remove Project...","category":".NET"},{"command":"csdevkit.addLinkedFile","title":"Add Linked File...","category":".NET"},{"command":"csdevkit.buildAndRunTests","title":"Build and Run C# Tests","category":".NET"},{"command":"csdevkit.runTests","title":"Run Tests","category":"Tes